# === Login do dashboard (Vercel Environment Variables) ===
ADMIN_USER=anderson@escondigital.com.br
ADMIN_PASSWORD=sua-senha-forte-aqui
AUTH_SECRET=string-aleatoria-longa

# === OpenRouter (chat no Vercel + CLI local) ===
# Onde colocar no Vercel: Project → Settings → Environment Variables
# Name: OPENROUTER_API_KEY   Value: sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-sua-chave
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
# Alias local CLI: kimi | gpt | gps | grok | deepseek | gemini | claude
LLM_MODEL=deepseek
LLM_PROVIDER=auto

# === xAI direto (opcional, se não usar OpenRouter) ===
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

# Escritório
ESCON_OFFICE_NAME=Escon Soluções Contábeis
ESCON_DATA_DIR=./data
ESCON_OFFLINE=false

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Google Drive for Desktop — pasta local "Radar Escon" (inbox automática)
# Ex.: C:\Users\ander\Google Drive\Radar Escon  ou  G:\Meu Drive\Radar Escon
# GOOGLE_DRIVE_RADAR_ROOT=

# Radar VPS (sync-inbox MinIO)
# RADAR_SSH_HOST=76.13.224.42
# RADAR_SSH_KEY=C:\Users\ander\.ssh\radar_escon_vps
